# SIVO Puskesmas - Environment Configuration Template
# Salin berkas ini menjadi .env dan sesuaikan kredensial dengan server Anda.
# JANGAN PERNAH mencantumkan password produksi di file yang di-commit ke Git.

APP_ENV=production
BASE_URL=/

# Konfigurasi Koneksi Database MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dbpuskesmas
DB_USER=sivo_dbuser
DB_PASS=ganti_dengan_password_aman
